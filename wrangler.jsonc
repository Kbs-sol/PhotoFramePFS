{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photoframein",
  "compatibility_date": "2026-03-28",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // ─────────────────────────────────────────────────────────────────
  // SECRETS (set via Cloudflare Dashboard or wrangler CLI):
  // wrangler pages secret put SUPABASE_URL --project-name photoframein
  // wrangler pages secret put SUPABASE_ANON_KEY --project-name photoframein
  // wrangler pages secret put SUPABASE_SERVICE_KEY --project-name photoframein
  // wrangler pages secret put RAZORPAY_KEY_ID --project-name photoframein
  // wrangler pages secret put RAZORPAY_KEY_SECRET --project-name photoframein
  // wrangler pages secret put ADMIN_TOKEN --project-name photoframein
  // wrangler pages secret put ADMIN_PASSWORD --project-name photoframein
  // wrangler pages secret put OWNER_EMAIL --project-name photoframein
  // wrangler pages secret put ALERT_EMAIL --project-name photoframein
  // wrangler pages secret put SHIPROCKET_EMAIL --project-name photoframein
  // wrangler pages secret put SHIPROCKET_PASSWORD --project-name photoframein
  // wrangler pages secret put BREVO_API_KEY --project-name photoframein
  // wrangler pages secret put RESEND_API_KEY --project-name photoframein
  // wrangler pages secret put WHATSAPP_NUMBER --project-name photoframein
  // wrangler pages secret put GTM_CONTAINER_ID --project-name photoframein
  // wrangler pages secret put GA4_MEASUREMENT_ID --project-name photoframein
  // wrangler pages secret put MICROSOFT_CLARITY_ID --project-name photoframein
  // ─────────────────────────────────────────────────────────────────
  // R2, KV, D1 bindings configured via Cloudflare dashboard if needed
}
