# PhotoFrameIn — Environment Variables
# Copy this to .dev.vars for local development
# For production: wrangler pages secret put <KEY> --project-name photoframein

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxx

# Shiprocket
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=your-password

# Email - Brevo (300/day free)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxx

# Email - Resend (100/day free, owner alerts)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Owner
OWNER_EMAIL=you@example.com
ALERT_EMAIL=vijayprasadvvp@gmail.com

# Cloudflare R2 (for image/video uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=photoframein-uploads

# Admin Panel
ADMIN_TOKEN=change-this-to-a-secure-token

# Google OAuth (via Supabase)
GOOGLE_CLIENT_ID=your-google-client-id

# WhatsApp
WHATSAPP_NUMBER=91XXXXXXXXXX

# Cloudinary (Image Hosting & Optimization)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ACTIVE_FOLDER=products

# Usage Monitor Limits (Monthly/Daily)
WORKER_MONTHLY_LIMIT=3000000
SUPABASE_ROW_LIMIT=50000
BREVO_DAILY_LIMIT=300
RESEND_DAILY_LIMIT=100

# Analytics (loaded via GTM)
GTM_CONTAINER_ID=GTM-XXXXXXX
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
MICROSOFT_CLARITY_ID=xxxxxxxxxx

# Store Config
CHECKOUT_MODE=shiprocket
COD_ENABLED=true
COD_MAX_VALUE=1995
COD_MIN_VALUE=499
COD_FEE=49
FREE_SHIPPING_THRESHOLD=799
PICKUP_PINCODE=501504
ACRYLIC_ENABLED=true
COMBOS_ENABLED=true
A4_OOS_THRESHOLD=10
