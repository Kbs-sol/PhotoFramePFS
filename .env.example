# ChitraFrame / frame-it — environment variables
# Copy to `.env` for local dev, and set these as Cloudflare Pages
# project environment variables (Settings → Environment variables) for production.
# All server functions read these via process.env — never expose secrets to the client.

# ── Supabase (auth + database) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Razorpay (payments) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Shiprocket (shipping rates + order sync) ─────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
PICKUP_PINCODE=501504
FREE_SHIPPING_THRESHOLD=999

# ── Email (order notifications) — Brevo primary, Resend fallback ─────────────
BREVO_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=noreply@chitraframe.in
FROM_NAME=ChitraFrame
OWNER_EMAIL=

# ── Site / auth ──────────────────────────────────────────────────────────────
SITE_URL=https://frame-it.pages.dev
SITE_NAME=ChitraFrame
MAGIC_LINK_SECRET=
WHATSAPP_NUMBER=91XXXXXXXXXX
